<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
    <interface>
        <!-- Set true by MainScene.brs when the user taps Update; main.brs
             observes this and turns it into an actual channel exit. -->
        <field id="exitApp" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
    <script type="text/brightscript" uri="pkg:/components/DebugLog.brs" />

    <children>
        <Rectangle id="bg" width="1920" height="1080" color="0x0A0A0EFF" />

        <!-- ==================== Full app content =========================
             Mounted once Spool is reachable and no update is blocking. -->
        <AppShell id="appShell" visible="false" />

        <!-- ==================== Full-screen message layer ================
             Used for: Spool down, Spool updating, update required,
             update available. -->
        <Group id="messageLayer" visible="false">
            <Rectangle width="1920" height="1080" color="0x0A0A0EF2" />

            <Label id="titleLabel" translation="[240,380]" width="1440" height="80"
                   font="font:LargeBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" />

            <Label id="bodyLabel" translation="[300,470]" width="1320" height="140"
                   font="font:MediumSystemFont" color="0xDCDCE2FF" horizAlign="center" wrap="true" />

            <Label id="versionLabel" visible="false" translation="[240,630]" width="1440" height="40"
                   font="font:SmallSystemFont" color="0x9A9BA8FF" horizAlign="center" />

            <Group id="buttonRow" visible="false" translation="[770,720]">
                <Rectangle id="updateBtnBg" width="180" height="64" color="0xFFFFFFFF" />
                <Label id="updateBtnLabel" text="Update" translation="[0,20]" width="180"
                       horizAlign="center" font="font:MediumBoldSystemFont" color="0x111111FF" />

                <Rectangle id="dismissBtnBg" visible="false" translation="[200,0]" width="180" height="64" color="0x2A2A2FFF" />
                <Label id="dismissBtnLabel" visible="false" text="Dismiss" translation="[200,20]" width="180"
                       horizAlign="center" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
            </Group>
        </Group>

        <!-- ==================== Persistent "update required" banner ======
             Shown top-right, after the user dismisses an OPTIONAL update
             prompt, until they actually update. -->
        <Group id="bannerGroup" visible="false" translation="[1500,40]">
            <Rectangle id="bannerBg" width="380" height="56" color="0xF5C518FF" />
            <Label id="bannerLabel" text="Update required" translation="[16,15]" width="348"
                   font="font:MediumBoldSystemFont" color="0x1A1A1AFF" />
        </Group>
    </children>
</component>
