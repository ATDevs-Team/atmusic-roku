<component name="TrackRow" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocusChange" />
    </interface>

    <script type="text/brightscript" uri="pkg:/components/TrackRow.brs" />
    <script type="text/brightscript" uri="pkg:/components/DebugLog.brs" />

    <children>
        <Rectangle id="rowBg" width="1400" height="104" color="0x16161AFF" />
        <Rectangle id="focusBg" width="1400" height="104" color="0x2A2A2FFF" visible="false" />
        <Rectangle id="nowPlayingBar" translation="[0,0]" width="6" height="104" color="0x4FD1C5FF" visible="false" />

        <Poster id="cover" translation="[14,14]" width="76" height="76"
                loadWidth="76" loadHeight="76" loadDisplayMode="scaleToZoom" />
        <Rectangle id="coverFallback" translation="[14,14]" width="76" height="76" color="0x2A2A2FFF" />

        <Label id="titleLabel" translation="[108,18]" width="1050" height="40"
               font="font:MediumBoldSystemFont" color="0xFFFFFFFF" ellipsizeOnBoundary="true" />
        <Label id="subtitleLabel" translation="[108,56]" width="1050" height="32"
               font="font:SmallSystemFont" color="0x9A9BA8FF" ellipsizeOnBoundary="true" />

        <Label id="metaLabel" translation="[1180,18]" width="200" height="32"
               font="font:SmallSystemFont" color="0x9A9BA8FF" horizAlign="right" />
        <Label id="favLabel" translation="[1180,54]" width="200" height="32"
               font="font:SmallSystemFont" color="0xF5C518FF" horizAlign="right" />
    </children>
</component>
